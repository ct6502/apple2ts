msgid "To learn more, press the Next button."
msgstr "Tryck på Nästa om du vill veta mer."

msgctxt "tour.bootButton"
msgid "Click here to start the emulator."
msgstr "Klicka här för att starta emulatorn."

msgctxt "tour.retroBootButton"
msgid "Select this option to start the emulator."
msgstr "Välj det här alternativet för att starta emulatorn."

msgctxt "tour.resetButton"
msgid "Click here to Reset the Apple II and either reboot or enter BASIC."
msgstr ""
"Klicka här för att återställa Apple II och antingen starta om eller gå in i "
"BASIC."

