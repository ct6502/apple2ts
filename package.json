{
  "name": "apple2ts",
  "private": true,
  "version": "3.5.2",
  "license": "MIT",
  "homepage": "https://apple2ts.com",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "overrides": {
    "@fortawesome/fontawesome-common-types": "7.1.0",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    }
  },
  "scripts": {
    "prestart": "node tools/fetch-demozoo.mjs --prompt",
    "predeploy": "npm run build",
    "prebuild": "npm run check-qr-hgr-assembly && npm run check-i18n-catalogs && node tools/fetch-demozoo.mjs --no-prompt",
    "deploy": "gh-pages -d dist",
    "start": "vite --open",
    "host": "vite --open --host",
    "build": "tsc && vite build",
    "build:cloudflare": "npm run build && node tools/build-cloudflare-worker.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint-fix": "eslint . --fix --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pretest": "npm run check-qr-hgr-assembly && npm run check-i18n-catalogs && npm run test-po-catalog",
    "test": "jest",
    "generate-qr-hgr-assembly": "node tools/generate-qr-hgr-assembly.mjs",
    "check-qr-hgr-assembly": "node tools/generate-qr-hgr-assembly.mjs --check",
    "review-disassembly-tooltips": "node tools/render-disassembly-tooltip-review.mjs",
    "review-disassembly-translation-keys": "node tools/render-disassembly-tooltip-review.mjs --keys",
    "write-disassembly-tooltip-reviews": "node tools/render-disassembly-tooltip-review.mjs --write",
    "test-disassembly-tooltip-review": "node --test tools/render-disassembly-tooltip-review.test.mjs",
    "test-po-catalog": "node --test tools/i18n/*.test.mjs",
    "update-i18n-catalogs": "node tools/i18n/update-catalogs.mjs",
    "generate-i18n-catalogs": "node tools/i18n/generate-catalogs.mjs",
    "check-i18n-catalogs": "node tools/i18n/generate-catalogs.mjs --check"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "pako": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-joyride": "^3.2.0",
    "smplr": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/audioworklet": "^0.0.100",
    "@types/gapi.client.drive-v3": "^0.0.5",
    "@types/google.accounts": "^0.0.18",
    "@types/google.picker": "^0.0.52",
    "@types/jest": "^30.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-fontawesome": "^1.6.8",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/wicg-file-system-access": "^2023.10.6",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gettext-parser": "^9.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-util": "^30.0.5",
    "js-yaml": "^4.3.1",
    "jsasm6502": "^1.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}